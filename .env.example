# =============================================================================
# CAVGO Docker Compose environment variables
# =============================================================================
# Copy this file to `.env` and adjust values. Docker Compose automatically
# reads `.env` from the project root and substitutes ${VAR:-default} in the
# compose files. Entries here are also injected into containers when a service
# uses `env_file`.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Connection string builders (one per database, used by Go / Node services)
CAVGOMAIN_DB_URL=jdbc:postgresql://postgres:5432/cavgomain
RIDEHAIL_DB_URL=jdbc:postgresql://postgres:5432/ridehail
IKURIYE_DB_URL=jdbc:postgresql://postgres:5432/ikuriye
CAVGOMQT_DB_URL=jdbc:postgresql://postgres:5432/cavgomqt
NAVIGATION_DB_URL=jdbc:postgresql://postgres:5432/navigation
CAVGOTRIPS_DB_URL=host=postgres user=postgres password=postgres dbname=cavgotrips port=5432 sslmode=disable
CAVGOBOOKS_DB_URL=postgres://postgres:postgres@postgres:5432/cavgobooks?sslmode=disable
ADMINAGGREGATE_DB_URL=postgresql://postgres:postgres@postgres:5432/adminaggregate?sslmode=disable

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# -----------------------------------------------------------------------------
# Meilisearch
# -----------------------------------------------------------------------------
MEILI_ENV=development
MEILI_MASTER_KEY=cavgoSearchMasterKey
MEILISEARCH_URL=http://meilisearch:7700

# -----------------------------------------------------------------------------
# Nexxauth (identity provider) - local dev compose (docker-compose.yml)
# -----------------------------------------------------------------------------
NEXXAUTH_BASE_URL=https://auth.med.rw/master
NEXXAUTH_ORGANISATION_ID=1
NEXXAUTH_PUBLIC_
NEXXAUTH_CLIENT_ID=cli_vrwPaVOqk-EJHFft9o1Mq1g1W3h_KTCv6aNw6IlVit4
NEXXAUTH_CLIENT_TOKEN=nx_A-PoujyVQeOc-M9IWCPmRYtJ8QKIByUVZqHVm66By2M

# Nexxauth for hub/production compose (docker-compose-hub.yml). Uncomment and
# set these if running the hub compose directly, or they fall back to defaults.
# NEXXAUTH_HUB_BASE_URL=https://auth.nexxserve.dev/cavgo
# NEXXAUTH_HUB_ORGANISATION_ID=5
# NEXXAUTH_HUB_PUBLIC_KEY=
# NEXXAUTH_HUB_CLIENT_ID=
# NEXXAUTH_HUB_CLIENT_TOKEN=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated allowed origins, or "*" for all.
CORS_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# Google / Firebase credentials (cavgomqt)
# -----------------------------------------------------------------------------
# Path on the host to the firebase service-account JSON. Mounted into the
# cavgomqt container.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-credentials.json

# -----------------------------------------------------------------------------
# Ports (host side)
# -----------------------------------------------------------------------------
PORT_RABBITMQ=5672
PORT_RABBITMQ_MGMT=15672
PORT_REDIS=6379
PORT_POSTGRES=5432
PORT_EUREKA=8761
PORT_MAIN=6060
PORT_GATEWAY=8080
PORT_RIDEHAIL=6070
PORT_TRIPS=6080
PORT_BOOKING=6030
PORT_MQTT=6090
PORT_USSD=6050
PORT_ADMINAGGREGATE=4000
PORT_IKURIYE=6100
PORT_NAVIGATION=6040
PORT_OSRM=5000
PORT_MEILISEARCH=7700
