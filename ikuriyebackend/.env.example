[TEMPLATE]
# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/ikuriye
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Server Port
SERVER_PORT=6100

# Nexxauth (identity provider — auth + roles). Matches cavgomain configuration.
# NEXXAUTH_BASE_URL is the project's fixed base URL = origin + platform segment
# (e.g. https://auth.med.rw/master). The organisation is resolved automatically
# from the X-Client-Id header — no numeric organisation id is needed.
# The SERVER client comes from the console (client type SERVER, static nx_ token
# shown once).
NEXXAUTH_BASE_URL=https://auth.med.rw/master

# Public key used to verify org-access JWTs offline — the backend does NOT
# fetch keys at runtime. Paste the `publicKey` value (base64 DER SPKI, one
# line, no PEM headers) from GET /organisations/keys.
# Update whenever the organisation's key is rotated.
NEXXAUTH_PUBLIC_KEY=

# SERVER client registered in the Nexxauth organisation (static nx_ token)
NEXXAUTH_CLIENT_ID=cli_your-server-client-id
NEXXAUTH_CLIENT_TOKEN=nx_your-server-client-token

# Storage backend selection: auto | minio | supabase | local
# "auto" (default) uses MinIO first, then Supabase, then local disk.
STORAGE_PROVIDER=auto

# MinIO / S3-compatible object storage — preferred upload backend.
# The backend creates the "package-media" and "profiles" buckets automatically.
# MINIO_ENDPOINT is what the app connects to (inside Docker: http://minio:9000).
# MINIO_PUBLIC_ENDPOINT must be reachable by clients for presigned download
# URLs (e.g. https://files.example.com or http://localhost:9000 locally).
MINIO_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_PRESIGNED_EXPIRY_SECONDS=604800

# Supabase Storage — optional fallback when MinIO is not available.
# The backend proxies uploads and generates signed URLs so clients never
# see Supabase URLs or bucket names. Use the service_role key (not anon)
# so the backend can create signed URLs and bypass RLS.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Local file storage — used when no remote backend is configured or available.
# Files are stored under this path and served via /api/files/local/{bucket}/...
LOCAL_STORAGE_PATH=./storage

# Enable background migration of local files to the active remote backend
# (MinIO or Supabase) when it comes back. Set to false to keep files local.
STORAGE_MIGRATION_ENABLED=true

# CORS (comma-separated, use * for all)
CORS_ALLOWED_ORIGINS=*

# Cavgo Main — internal sync target. When a WORKER authenticates, ikuriye
# calls cavgomain to get the worker's office location id; cavgomain also pushes
# worker office changes to ikuriye. Empty/absent disables the sync.
CAVGOMAIN_BASE_URL=
