[TEMPLATE]
# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/ikuriye
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Server Port
SERVER_PORT=6100

# Nexxauth (identity provider — auth + roles). Matches cavgomain configuration.
# NEXXAUTH_BASE_URL is the project's fixed base URL = origin + platform segment
# (e.g. https://auth.med.rw/master). The organisation is resolved automatically
# from the X-Client-Id header — no numeric organisation id is needed.
# The SERVER client comes from the console (client type SERVER, static nx_ token
# shown once).
NEXXAUTH_BASE_URL=https://auth.med.rw/master

# Public key used to verify org-access JWTs offline — the backend does NOT
# fetch keys at runtime. Paste the `publicKey` value (base64 DER SPKI, one
# line, no PEM headers) from GET /organisations/keys.
# Update whenever the organisation's key is rotated.
NEXXAUTH_PUBLIC_KEY=

# SERVER client registered in the Nexxauth organisation (static nx_ token)
NEXXAUTH_CLIENT_ID=cli_your-server-client-id
NEXXAUTH_CLIENT_TOKEN=nx_your-server-client-token

# Supabase Storage — file uploads (package media + profile avatars).
# The backend proxies uploads and generates signed URLs so clients never
# see Supabase URLs or bucket names. Use the service_role key (not anon)
# so the backend can create signed URLs and bypass RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# Local file storage — used when Supabase is not configured or unavailable.
# Files are stored under this path and served via /api/files/local/{bucket}/...
LOCAL_STORAGE_PATH=./storage

# Enable background migration of local files to Supabase when it comes back.
# Set to false to keep files local permanently.
STORAGE_MIGRATION_ENABLED=true

# CORS (comma-separated, use * for all)
CORS_ALLOWED_ORIGINS=*
