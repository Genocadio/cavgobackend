# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adminaggregate

# Upstream services (required at startup)
MAIN_BASE_URL=http://localhost:6060
TRIPS_BASE_URL=http://localhost:6080

# Nexxauth verification — base64 DER SPKI publicKey from GET /organisations/keys.
# Without this, every GraphQL request is treated as unauthenticated.
NEXXAUTH_PUBLIC_KEY=

# Shared secret required by cavgomain's /company/:companyId/vehicle|worker push endpoints.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# RabbitMQ (optional overrides; defaults to localhost:5672 / admin / admin)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin
# SNAPSHOT_EXCHANGE=bookingservice.trip.snapshot

PORT=4000
